# Django
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=mashaghi.ir,www.mashaghi.ir,localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=https://mashaghi.ir,https://www.mashaghi.ir

# Database — Docker Compose
DB_ENGINE=django.db.backends.postgresql
DB_NAME=postgres
DB_USER=root
DB_PASSWORD=change-me
DB_HOST=db
DB_PORT=5432

# Database — Liara (use one of DATABASE_URL or DB_* blocks)
# DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/postgres

# Email
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=your@gmail.com
EMAIL_HOST_PASSWORD=your-app-password
DEFAULT_FROM_EMAIL=your@gmail.com
CONTACT_NOTIFICATION_EMAIL=your@gmail.com

# Optional: Liara Object Storage
# LIARA_BUCKET_NAME=
# LIARA_ACCESS_KEY=
# LIARA_SECRET_KEY=
# LIARA_ENDPOINT=

# Google Sign-In (OAuth client — Web application)
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-client-secret
# If VPS cannot reach googleapis.com, cache certs locally (see README / fetch_google_jwks)
GOOGLE_JWKS_PATH=/app/data/google_jwks.json
# Or use an outbound proxy that can reach Google:
# GOOGLE_HTTPS_PROXY=http://user:pass@proxy-host:8080

# Redis / Celery — Docker Compose service hostnames
REDIS_URL=redis://redis:6379/1
CELERY_BROKER_URL=amqp://guest:guest@rabbitmq:5672//
CELERY_RESULT_BACKEND=redis://redis:6379/0
# CELERY_TASK_ALWAYS_EAGER=True

# Gunicorn
GUNICORN_WORKERS=3
GUNICORN_TIMEOUT=60

# Compose host ports
# Deployment (local Windows): HTTP_PORT=8080
# Production (VPS): HTTP_PORT=80  HTTPS_PORT=443
HTTP_PORT=8080
HTTPS_PORT=443
RABBITMQ_PORT=5672
RABBITMQ_MGMT_PORT=15672

# Docker Compose (from project root):
#   docker compose -f docker/compose.yml -f docker/compose.deployment.yml --env-file .env.deployment up -d --build
#   docker compose -f docker/compose.yml -f docker/compose.prod.yml --env-file .env.production up -d --build
