# Django
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=mashaghi.ir,www.mashaghi.ir,localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=https://mashaghi.ir,https://www.mashaghi.ir

# Database — Docker Compose
DB_ENGINE=django.db.backends.postgresql
DB_NAME=postgres
DB_USER=root
DB_PASSWORD=change-me
DB_HOST=db
DB_PORT=5432

# Database — Liara (use one of DATABASE_URL or DB_* blocks)
# DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/postgres

# Email
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=your@gmail.com
EMAIL_HOST_PASSWORD=your-app-password
DEFAULT_FROM_EMAIL=your@gmail.com
CONTACT_NOTIFICATION_EMAIL=your@gmail.com

# Optional: Liara Object Storage
# LIARA_BUCKET_NAME=
# LIARA_ACCESS_KEY=
# LIARA_SECRET_KEY=
# LIARA_ENDPOINT=

# Gunicorn
GUNICORN_WORKERS=3
GUNICORN_TIMEOUT=60

# Optional ports (defaults: 80 / 443)
# HTTP_PORT=80
# HTTPS_PORT=443
